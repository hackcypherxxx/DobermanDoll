# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/reborn-doll

# ── URLs ────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# ── Secrets (each MUST be at least 32 characters) ───────
JWT_SECRET=replace-with-a-random-32-plus-character-string
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-string
COOKIE_SECRET=replace-with-another-random-32-plus-character-string

# ── Optional: seed an initial SUPER_ADMIN on first boot ─
# Leave unset to rely on `npm run seed:admin` instead.
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=change-me-to-a-strong-password

# ── Resend (email) ──────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# ── Cloudinary (product images) ─────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
